LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret0000000000000000000000000000000000
LIVEKIT_HOST=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
ACCESS_PASSPHRASE=
MONGO_URI=mongodb://mongo:27017/voicesystem
FLASK_SECRET_KEY=change-me-in-production
COTURN_USER=turnuser
COTURN_PASS=turnpass
DEV_MODE=false
ENABLE_ZULIP_AUTH=false

# Zulip Integration
ZULIP_URL=https://zulip.example.com
ZULIP_EMAIL=bot@example.com
ZULIP_API_KEY=your-bot-api-key

# Matrix Integration — federated login as '@user:homeserver' + password.
# MATRIX_ALLOWED_HOMESERVERS is a security control, not a convenience: without it any
# valid Matrix account anywhere could sign in. Empty = federated login off. '*' = any.
ENABLE_MATRIX_AUTH=false
MATRIX_ALLOWED_HOMESERVERS=

# Branding / UI (per-deployment)
APP_NAME=VoiceCom
ENABLE_SECTORS=true

# Super Admin (Recovery)
# HASH generated via: python3 -c 'import bcrypt; print(bcrypt.hashpw(b"password", bcrypt.gensalt()).decode())'
SUPER_ADMIN_EMAIL=admin@voicecom.local
SUPER_ADMIN_HASH=
